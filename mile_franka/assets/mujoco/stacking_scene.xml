<!-- Single-arm Franka + two stacking cubes, for the MILE block-stacking sim.
     Mirrors multipanda's franka_description/mujoco/franka/scene.xml (which loads only the robot)
     and adds our cubes via stacking_objects.xml, following the dual_scene.xml include pattern.

     This file is loaded by mujoco_ros as the `modelfile` (see launch/franka_sim_stacking.launch.py).
     The relative includes (panda.xml, its meshdir="assets") require this file to sit IN
     franka_description/mujoco/franka/ at runtime. We achieve that by bind-mounting this file and
     stacking_objects.xml into that directory in the container (see docker/), so we never edit the
     upstream franka_description package. -->
<mujoco model="panda stacking scene">

  <include file="panda.xml"/>
  <include file="stacking_objects.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
        height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
        rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
        reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Fixed camera framing the workspace, for headless rendering via mujoco_ros2_sensors
         (topic-based) as an alternative to Xvfb viewer capture. Pose tunable at bring-up. -->
    <camera name="stack_cam" pos="1.35 0.0 0.75" xyaxes="0 -1 0 0.5 0 1" fovy="45"/>
  </worldbody>
</mujoco>
